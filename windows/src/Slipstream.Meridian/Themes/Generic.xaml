<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Slipstream.Meridian.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Slipstream.Meridian/Themes/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Slipstream.Meridian/Themes/Shapes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:StatusBrushKeyToBrushConverter x:Key="StatusBrushKeyToBrushConverter" />

    <!--
      MeridianCard: Surface fill, lg radius, 1px stroke, no elevation. No content padding
      baked in — the caller's content controls its own inset.
    -->
    <Style TargetType="local:MeridianCard">
        <Setter Property="Background" Value="{ThemeResource MeridianSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MeridianStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MeridianRadiusLg}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianSectionHeader: a Title on the leading edge, an optional trailing action.
      The action button collapses entirely (not just disables) when Title/ActionLabel/
      ActionCommand leave IsActionVisible false.
    -->
    <Style TargetType="local:MeridianSectionHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianSectionHeader">
                    <Grid ColumnSpacing="{StaticResource MeridianSpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   Style="{StaticResource MeridianItemTitleStyle}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1"
                                         Content="{TemplateBinding ActionLabel}"
                                         Command="{TemplateBinding ActionCommand}"
                                         Visibility="{Binding IsActionVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianIconTile: Tint fill, sm radius, Brand-tinted glyph, 44px tap-target floor
      independent of TileSize.
    -->
    <Style TargetType="local:MeridianIconTile">
        <Setter Property="Background" Value="{ThemeResource MeridianTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MeridianStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MeridianRadiusSm}" />
        <Setter Property="Padding" Value="{StaticResource MeridianSpacingSm}" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianIconTile">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Width="{TemplateBinding TileSize}"
                            Height="{TemplateBinding TileSize}">
                        <StackPanel Spacing="{StaticResource MeridianSpacingXs}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <FontIcon Glyph="{TemplateBinding Glyph}"
                                      Foreground="{ThemeResource MeridianBrandBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}"
                                       Style="{StaticResource MeridianLabelStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianStatusPill: colour is never the only cue. A small signal-coloured dot AND the
      text Label are always both present; the dot's fill and the text's foreground both come
      from BrushKeyFor(Status) via StatusBrushKeyToBrushConverter.
    -->
    <Style TargetType="local:MeridianStatusPill">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="{StaticResource MeridianSpacingSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianStatusPill">
                    <Border Background="{ThemeResource MeridianTintBrush}"
                            CornerRadius="{StaticResource MeridianRadiusPill}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource MeridianSpacingXs}"
                                    VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding BrushKey, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusBrushKeyToBrushConverter}}" />
                            <TextBlock Text="{TemplateBinding Label}"
                                       Style="{StaticResource MeridianLabelBoldStyle}"
                                       Foreground="{Binding BrushKey, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusBrushKeyToBrushConverter}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianStateView: Loading / Content / Empty / Error, switched via VisualStateManager —
      the same four-state contract as the Compose implementation. Error message text is
      re-coloured to MeridianCriticalBrush by the Error VisualState's Setter; everything else
      about the message panel (layout, action button) is shared with Empty so the two states
      stay visually related.
    -->
    <Style TargetType="local:MeridianStateView">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianStateView">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Loading">
                                    <VisualState.Setters>
                                        <Setter Target="LoadingIndicator.Visibility" Value="Visible" />
                                        <Setter Target="ContentHost.Visibility" Value="Collapsed" />
                                        <Setter Target="MessagePanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Content">
                                    <VisualState.Setters>
                                        <Setter Target="LoadingIndicator.Visibility" Value="Collapsed" />
                                        <Setter Target="ContentHost.Visibility" Value="Visible" />
                                        <Setter Target="MessagePanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Empty">
                                    <VisualState.Setters>
                                        <Setter Target="LoadingIndicator.Visibility" Value="Collapsed" />
                                        <Setter Target="ContentHost.Visibility" Value="Collapsed" />
                                        <Setter Target="MessagePanel.Visibility" Value="Visible" />
                                        <Setter Target="MessageText.Foreground" Value="{ThemeResource MeridianInkMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="LoadingIndicator.Visibility" Value="Collapsed" />
                                        <Setter Target="ContentHost.Visibility" Value="Collapsed" />
                                        <Setter Target="MessagePanel.Visibility" Value="Visible" />
                                        <Setter Target="MessageText.Foreground" Value="{ThemeResource MeridianCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ProgressRing x:Name="LoadingIndicator"
                                      IsActive="True"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        <ContentPresenter x:Name="ContentHost"
                                           Content="{TemplateBinding Content}"
                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <StackPanel x:Name="MessagePanel"
                                    Visibility="Collapsed"
                                    Spacing="{StaticResource MeridianSpacingMd}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="320">
                            <TextBlock x:Name="MessageText"
                                       Text="{TemplateBinding Message}"
                                       Style="{StaticResource MeridianBodyStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Content="{TemplateBinding ActionLabel}"
                                    Command="{TemplateBinding ActionCommand}"
                                    HorizontalAlignment="Center"
                                    MinWidth="44"
                                    MinHeight="44" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianStatCard: a small muted label above a large bold tabular number, on the same
      Surface/Stroke/lg-radius visual language as MeridianCard.
    -->
    <Style TargetType="local:MeridianStatCard">
        <Setter Property="Background" Value="{ThemeResource MeridianSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MeridianStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MeridianRadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource MeridianSpacingLg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianStatCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Spacing="{StaticResource MeridianSpacingXs}">
                            <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource MeridianLabelStyle}" />
                            <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource MeridianStatValueStyle}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianHeroMetric: the one-per-screen 40sp/Bold/Tabular/Brand number, e.g. the live
      transfer rate. Just a thin Control wrapper over MeridianHeroMetricStyle so callers bind
      a single pre-formatted Value string.
    -->
    <Style TargetType="local:MeridianHeroMetric">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianHeroMetric">
                    <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource MeridianHeroMetricStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
