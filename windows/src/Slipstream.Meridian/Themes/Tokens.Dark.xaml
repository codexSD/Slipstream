<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Meridian roles. The ONLY file (with its Dark twin) permitted a colour literal. -->
    <SolidColorBrush x:Key="MeridianCanvasBrush"       Color="#0F1014" />
    <SolidColorBrush x:Key="MeridianSurfaceBrush"      Color="#17181D" />
    <SolidColorBrush x:Key="MeridianStrokeBrush"       Color="#2A2C35" />
    <SolidColorBrush x:Key="MeridianTintBrush"         Color="#1D2739" />
    <SolidColorBrush x:Key="MeridianInkBrush"          Color="#EDEEF2" />
    <SolidColorBrush x:Key="MeridianInkMutedBrush"     Color="#9B9EAC" />
    <SolidColorBrush x:Key="MeridianBrandBrush"        Color="#6BA5F0" />
    <SolidColorBrush x:Key="MeridianBrandStrongBrush"  Color="#8FBDF5" />
    <SolidColorBrush x:Key="MeridianOnBrandBrush"      Color="#0F1014" />
    <SolidColorBrush x:Key="MeridianOnBrandMutedBrush" Color="#16324F" />
    <SolidColorBrush x:Key="MeridianStrongBrush"       Color="#EDEEF2" />
    <SolidColorBrush x:Key="MeridianPositiveBrush"     Color="#5FC98D" />
    <SolidColorBrush x:Key="MeridianWarningBrush"      Color="#F0AD52" />
    <SolidColorBrush x:Key="MeridianCriticalBrush"     Color="#EE7C7C" />
    <!-- Info equals Brand on purpose: an in-flight item is not an alarm. -->
    <SolidColorBrush x:Key="MeridianInfoBrush"         Color="#6BA5F0" />

    <!--
      System overrides. NOT optional and NOT dead weight: a stock WinUI control that
      reaches for one of these and finds it undefined renders the system Fluent accent
      instead of Meridian's blue — silently, with a correct-looking designer preview.
      Do not delete an entry because "nothing uses it"; a future stock control will.
    -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"        Color="#6BA5F0" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"      Color="#8FBDF5" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"          Color="#EDEEF2" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"        Color="#9B9EAC" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"       Color="#17181D" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"     Color="#2A2C35" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"         Color="#17181D" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"  Color="#0F1014" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"  Color="#6BA5F0" />
</ResourceDictionary>
