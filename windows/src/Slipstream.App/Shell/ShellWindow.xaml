<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Slipstream_App.Shell.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Slipstream.App.Shell"
    xmlns:meridian="using:Slipstream.Meridian.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Slipstream"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource MeridianCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Slipstream">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: navigation destinations only. No search box, no bottom user chip. -->
            <Border Grid.Column="0"
                    Background="{ThemeResource MeridianSurfaceBrush}"
                    BorderBrush="{ThemeResource MeridianInkMutedBrush}"
                    BorderThickness="0,0,1,0">
                <ListView x:Name="NavList"
                          ItemsSource="{x:Bind ViewModel.Destinations}"
                          SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="12,16,12,0"
                          SelectionChanged="NavList_SelectionChanged">
                    <ListView.Resources>
                        <!--
                            Active leaf is a filled Brand pill (spec §12): override the
                            themed selection brushes ListViewItem's default template reads,
                            scoped to this list only, rather than touching the app theme.
                            These MUST live inside ThemeDictionaries (mirroring App.xaml) —
                            a plain ResourceDictionary entry resolves {StaticResource} once at
                            parse time and would not follow a live theme switch.
                        -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="MeridianBrandBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="MeridianBrandBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="MeridianBrandStrongBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="MeridianOnBrandBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="MeridianBrandBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="MeridianBrandBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="MeridianBrandStrongBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="MeridianOnBrandBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ShellDestination">
                            <Grid Padding="12,10">
                                <TextBlock Text="{x:Bind Label}"
                                           Style="{StaticResource MeridianBodyStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{ThemeResource MeridianInkMutedBrush}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="CornerRadius" Value="18" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

            <!-- Content column: top bar + page content. No search box in the top bar. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="28,20,28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Selected.Label, Mode=OneWay}"
                                   Style="{StaticResource MeridianScreenTitleStyle}" />
                        <TextBlock Text="{x:Bind PageSubtitle, Mode=OneWay}"
                                   Style="{StaticResource MeridianBodyStyle}"
                                   Foreground="{ThemeResource MeridianInkMutedBrush}" />
                    </StackPanel>

                    <meridian:MeridianStatusPill Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Status="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                                                  Label="{x:Bind ViewModel.ConnectionLabel, Mode=OneWay}" />
                </Grid>

                <!--
                    The five destination views need their IPeerHost / TransferQueue /
                    HistoryStore / SettingsStore injected at construction, which a DataTemplate
                    cannot do. They are therefore built once in the code-behind (where those
                    dependencies are in scope) and swapped into this host directly - see
                    ShellWindow's _destinationViews. They deliberately are NOT stashed in a
                    ResourceDictionary and pulled out with {StaticResource}: WinUI treats every
                    value in a ResourceDictionary as shareable, so assigning such an element to
                    ContentControl.Content throws E_INVALIDARG and kills the process during
                    Window.Activate().
                -->
                <ContentControl x:Name="PageHost"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Padding="28,0,28,28" />
            </Grid>
        </Grid>
    </Grid>
</Window>
