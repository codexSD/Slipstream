<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Slipstream_App.Pages.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Slipstream.App.Pages"
    xmlns:meridian="using:Slipstream.Meridian.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Active and recent transfers this session."
                   Style="{StaticResource MeridianBodyStyle}"
                   Foreground="{ThemeResource MeridianInkMutedBrush}" />

        <!-- Data-table view of every transfer this session has queued (spec §12's data-table). -->
        <meridian:MeridianDataGrid x:Name="DataGrid"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" />
    </Grid>
</UserControl>
