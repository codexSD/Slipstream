<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Slipstream.Meridian.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Slipstream.Meridian/Themes/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Slipstream.Meridian/Themes/Shapes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!--
      MeridianCard: Surface fill, lg radius, 1px stroke, no elevation. No content padding
      baked in — the caller's content controls its own inset.
    -->
    <Style TargetType="local:MeridianCard">
        <Setter Property="Background" Value="{ThemeResource MeridianSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MeridianStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MeridianRadiusLg}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianSectionHeader: a Title on the leading edge, an optional trailing action.
      The action button collapses entirely (not just disables) when Title/ActionLabel/
      ActionCommand leave IsActionVisible false.
    -->
    <Style TargetType="local:MeridianSectionHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianSectionHeader">
                    <Grid ColumnSpacing="{StaticResource MeridianSpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   Style="{StaticResource MeridianItemTitleStyle}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1"
                                         Content="{TemplateBinding ActionLabel}"
                                         Command="{TemplateBinding ActionCommand}"
                                         Visibility="{Binding IsActionVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MeridianIconTile: Tint fill, sm radius, Brand-tinted glyph, 44px tap-target floor
      independent of TileSize.
    -->
    <Style TargetType="local:MeridianIconTile">
        <Setter Property="Background" Value="{ThemeResource MeridianTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MeridianStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MeridianRadiusSm}" />
        <Setter Property="Padding" Value="{StaticResource MeridianSpacingSm}" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MeridianIconTile">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Width="{TemplateBinding TileSize}"
                            Height="{TemplateBinding TileSize}">
                        <StackPanel Spacing="{StaticResource MeridianSpacingXs}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <FontIcon Glyph="{TemplateBinding Glyph}"
                                      Foreground="{ThemeResource MeridianBrandBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}"
                                       Style="{StaticResource MeridianLabelStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
