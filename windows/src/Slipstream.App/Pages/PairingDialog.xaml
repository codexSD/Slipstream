<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Slipstream_App.Pages.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Slipstream.App.Pages"
    xmlns:meridian="using:Slipstream.Meridian.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pair a device"
    PrimaryButtonText="Confirm"
    CloseButtonText="Decline"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}">

    <ContentDialog.Resources>
        <!-- ≥44px tap targets for the Confirm/Decline buttons. -->
        <Style x:Key="PairingButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="20" MinWidth="360">

        <!-- The one thing software cannot enforce: the human has to actually compare the
             codes. Naming the peer and the action in the prompt is what makes that happen
             (protocol/pairing.md §5). -->
        <TextBlock Text="{x:Bind ViewModel.Prompt, Mode=OneWay}"
                   Style="{StaticResource MeridianBodyStyle}"
                   TextWrapping="Wrap" />

        <!-- The code: MeridianHeroMetric size, unmissable, with extra letter spacing so the
             six digits read as six distinct digits rather than a run-on number. -->
        <TextBlock Text="{x:Bind ViewModel.Code, Mode=OneWay}"
                   Style="{StaticResource MeridianHeroMetricStyle}"
                   CharacterSpacing="400"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{x:Bind ViewModel.TimeRemaining, Mode=OneWay}"
                   Style="{StaticResource MeridianLabelStyle}"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Style="{StaticResource MeridianLabelStyle}"
                   Foreground="{ThemeResource MeridianInkMutedBrush}"
                   HorizontalAlignment="Center" />

    </StackPanel>

    <ContentDialog.PrimaryButtonStyle>
        <StaticResource ResourceKey="PairingButtonStyle" />
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <StaticResource ResourceKey="PairingButtonStyle" />
    </ContentDialog.CloseButtonStyle>
</ContentDialog>
