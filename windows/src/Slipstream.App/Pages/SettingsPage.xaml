<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Slipstream_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Slipstream.App.Pages"
    xmlns:meridian="using:Slipstream.Meridian.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

            <!-- Transfer -->
            <meridian:MeridianCard>
                <StackPanel Spacing="16" Padding="20">
                    <meridian:MeridianSectionHeader Title="Transfer" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Parallel streams"
                                       Style="{StaticResource MeridianBodyStyle}" />
                            <TextBlock Text="How many streams a pull uses at once. 1–8."
                                       Style="{StaticResource MeridianBodyStyle}"
                                       Foreground="{ThemeResource MeridianInkMutedBrush}" />
                        </StackPanel>

                        <!--
                            No MeridianStepper exists in Slipstream.Meridian.Controls (the
                            plan's Android component list mentions one, but it was never
                            ported to WinUI in an earlier task) — a NumberBox with SpinButtons
                            is the closest first-party WinUI substitute for "a genuinely
                            bounded integer stepper". SettingsViewModel.StreamCount already
                            clamps to [1,8] regardless of what value NumberBox lets through.
                        -->
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.StreamCount, Mode=TwoWay}"
                                   Minimum="1" Maximum="8"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="1"
                                   Width="120"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Download folder"
                                       Style="{StaticResource MeridianBodyStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}"
                                       Style="{StaticResource MeridianBodyStyle}"
                                       Foreground="{ThemeResource MeridianInkMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="ChooseFolderButton"
                                Content="Choose…"
                                Click="ChooseFolderButton_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </meridian:MeridianCard>

            <!-- Appearance -->
            <meridian:MeridianCard>
                <StackPanel Spacing="16" Padding="20">
                    <meridian:MeridianSectionHeader Title="Appearance" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="ThemeSystemRadio" Content="System"
                                     GroupName="Theme" Checked="ThemeRadio_Checked" Tag="System" />
                        <RadioButton x:Name="ThemeLightRadio" Content="Light"
                                     GroupName="Theme" Checked="ThemeRadio_Checked" Tag="Light" />
                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark"
                                     GroupName="Theme" Checked="ThemeRadio_Checked" Tag="Dark" />
                    </StackPanel>
                </StackPanel>
            </meridian:MeridianCard>

            <!-- Devices -->
            <meridian:MeridianCard>
                <StackPanel Spacing="16" Padding="20">
                    <meridian:MeridianSectionHeader Title="Devices" />

                    <Button x:Name="PairDeviceButton"
                            Content="Pair a device"
                            Click="PairDeviceButton_Click" />

                    <!-- Spec §16: PC hosts the hotspot, so a slow link is explained rather
                         than left for the user to guess about. Names the band the shell
                         currently reports for the connected peer. -->
                    <TextBlock Style="{StaticResource MeridianBodyStyle}"
                               Foreground="{ThemeResource MeridianInkMutedBrush}"
                               TextWrapping="Wrap">
                        <Run Text="This PC hosts the hotspot your phone connects through. Speed depends on that link — currently" />
                        <Run Text="{x:Bind ViewModel.BandText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="." />
                    </TextBlock>
                </StackPanel>
            </meridian:MeridianCard>

            <!-- Startup -->
            <meridian:MeridianCard>
                <StackPanel Spacing="16" Padding="20">
                    <meridian:MeridianSectionHeader Title="Startup" />

                    <ToggleSwitch Header="Launch Slipstream when you sign in"
                                  IsOn="{x:Bind ViewModel.AutostartEnabled, Mode=TwoWay}" />
                </StackPanel>
            </meridian:MeridianCard>

        </StackPanel>
    </ScrollViewer>
</Page>
