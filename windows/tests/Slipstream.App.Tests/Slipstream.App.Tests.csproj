<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Slipstream.App is a WinUI project with <Platforms>x86;x64;ARM64</Platforms> and no
      AnyCPU. If this test project stays AnyCPU, a solution-level build hands Slipstream.App
      a platform it cannot honour, the RuntimeIdentifier stops matching the PlatformTarget
      (NETSDK1032), and Slipstream.App.Tests never builds - while dotnet test still runs the
      projects that DID build and exits reporting only 1 test file. Mirroring the platform
      list keeps the two projects in lockstep so the failure cannot recur silently.
    -->
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Slipstream.App\Slipstream.App.csproj" />
    <ProjectReference Include="..\..\src\Slipstream.Core\Slipstream.Core.csproj" />
    <ProjectReference Include="..\..\src\Slipstream.Meridian\Slipstream.Meridian.csproj" />
    <ProjectReference Include="..\Slipstream.Core.Tests\Slipstream.Core.Tests.csproj" />
  </ItemGroup>

</Project>