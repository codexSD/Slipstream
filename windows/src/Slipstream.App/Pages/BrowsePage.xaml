<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Slipstream_App.Pages.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Slipstream.App.Pages"
    xmlns:meridian="using:Slipstream.Meridian.Controls"
    xmlns:files="using:Slipstream.Core.Files"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <meridian:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>


    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: breadcrumbs + right-aligned search (spec §12's data-table toolbar). -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource MeridianBodyStyle}" />
                            <TextBlock Text="/" Foreground="{ThemeResource MeridianInkMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Grid.Column="1"
                      x:Name="SearchBox"
                      PlaceholderText="Search this folder"
                      Width="220"
                      TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- Filter chips + gallery toggle + back button. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Back"
                    Click="Back_Click" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="AllChip" Content="All" IsChecked="True" Click="FilterChip_Click" />
                <ToggleButton x:Name="VideoChip" Content="Video" Click="FilterChip_Click" />
                <ToggleButton x:Name="AudioChip" Content="Audio" Click="FilterChip_Click" />
                <ToggleButton x:Name="ImagesChip" Content="Images" Click="FilterChip_Click" />
                <ToggleButton x:Name="DocsChip" Content="Docs" Click="FilterChip_Click" />
            </StackPanel>

            <ToggleButton Grid.Column="2"
                          x:Name="GalleryToggle"
                          Content="Gallery view"
                          Click="GalleryToggle_Click" />
        </Grid>

        <!-- Truncation notice: only visible when the peer actually reported truncation. -->
        <InfoBar Grid.Row="2"
                 Severity="Informational"
                 IsOpen="{x:Bind ViewModel.IsTruncated, Mode=OneWay}"
                 Message="{x:Bind ViewModel.TruncationNotice, Mode=OneWay}"
                 IsClosable="False" />

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                   Visibility="Collapsed" />

        <meridian:MeridianStateView Grid.Row="4"
                                     State="{x:Bind ViewModel.State, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
            <Grid>
                <!-- Default view: MeridianDataGrid (spec §12). -->
                <meridian:MeridianDataGrid x:Name="DataGrid"
                                            ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                                            Visibility="{x:Bind IsGalleryView, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            DoubleTapped="DataGrid_DoubleTapped" />

                <!-- Gallery view toggle for media-heavy folders: thumbnails load lazily from
                     /thumb/{token} as rows scroll (spec §12) once the thumbnail-fetch path
                     exists on IPeerHost; for now this shows name + type per entry. -->
                <GridView x:Name="GalleryView"
                          ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                          Visibility="{x:Bind IsGalleryView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          DoubleTapped="GalleryView_DoubleTapped">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="files:FileEntry">
                            <StackPanel Width="120" Spacing="4" Margin="4">
                                <Border Height="90"
                                        Background="{ThemeResource MeridianSurfaceBrush}"
                                        CornerRadius="6" />
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource MeridianBodyStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </meridian:MeridianStateView>
    </Grid>
</Page>
